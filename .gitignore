# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# VS Code
# A bare ".vscode/" ignores the directory itself, which git will then
# never descend into -- so a file-level negation below would silently
# not apply. Ignoring "*" inside the directory instead keeps the same
# default (everything in .vscode/ is ignored) while still allowing the
# specific negations below to work.
.vscode/*
# Post-MVP2 Enhancement 01: shared, project-level workspace configuration
# is a required deliverable (interpreter path, pytest discovery, tasks,
# debug configs) so any QE engineer opening this repo in Windows VS Code
# gets a working setup without switching to WSL. Only these three shared
# files are un-ignored; any other machine-specific VS Code state (caches,
# personal overrides) remains ignored.
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Environment / secrets
.env
.env.*
!.env.example

# Runtime artifacts
runs/
evidence/

# Playwright
playwright-report/
test-results/

# JMeter
*.jtl
# CP-MVP2-08: the actual, committed .jtl evidence for the real JMeter
# execution this checkpoint requires (docs/CP-MVP2-08-SPECIFICATION-v1.0.md
# sec. 11) is deliberately un-ignored here.
!performance/generated/raw/**/*.jtl
# Post-MVP2 Enhancement 01: same rationale, for the new modular JMeter
# scenario's real execution results.
!performance/jmeter/results/**/*.jtl

# OS
.DS_Store
Thumbs.db
